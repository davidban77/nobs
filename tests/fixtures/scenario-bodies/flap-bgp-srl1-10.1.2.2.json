{
  "version": 2,
  "kind": "runnable",
  "scenario_name": "packt-cascade-srl1-bgp-10-1-2-2",
  "category": "network",
  "description": "Packt inversion cascade \u2014 pauses srl1 peer 10.1.2.2 baseline during BGP-DOWN phase.",
  "defaults": {
    "rate": 1,
    "duration": "4m",
    "labels": {
      "source": "srl1"
    }
  },
  "scenarios": [
    {
      "id": "cascade_active",
      "signal_type": "metrics",
      "name": "cascade_active",
      "generator": {
        "type": "flap",
        "up_duration": "40s",
        "down_duration": "50s",
        "up_value": 0,
        "down_value": 1
      }
    },
    {
      "id": "cascade_srl_bgp_oper_state",
      "signal_type": "metrics",
      "name": "srl_bgp_oper_state",
      "generator": {
        "type": "constant",
        "value": 2.0
      },
      "while": {
        "ref": "cascade_active",
        "op": ">",
        "value": 0
      },
      "labels": {
        "peer_address": "10.1.2.2",
        "neighbor_asn": "65102",
        "afi_safi_name": "ipv4-unicast",
        "name": "default",
        "collection_type": "gnmi"
      }
    },
    {
      "id": "cascade_srl_bgp_neighbor_state",
      "signal_type": "metrics",
      "name": "srl_bgp_neighbor_state",
      "generator": {
        "type": "constant",
        "value": 2.0
      },
      "while": {
        "ref": "cascade_active",
        "op": ">",
        "value": 0
      },
