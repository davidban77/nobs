{
  "version": 2,
  "kind": "runnable",
  "scenario_name": "incident-link-failover-srl1",
  "category": "network",
  "description": "Link failover cascade on srl1 (ethernet-1/10 \u2192 ethernet-1/1)",
  "defaults": {
    "rate": 1,
    "duration": "3m",
    "encoder": {
      "type": "remote_write"
    },
    "sink": {
      "type": "remote_write",
      "url": "http://prometheus:9090/api/v1/write"
    },
    "labels": {
      "device": "srl1",
      "pipeline": "direct",
      "collection_type": "gnmi",
      "intf_role": "peer",
      "source": "incident-cascade"
    }
  },
  "scenarios": [
    {
      "id": "primary_flap",
      "signal_type": "metrics",
      "name": "interface_oper_state",
      "generator": {
        "type": "flap",
        "up_duration": "60s",
        "down_duration": "30s"
      },
      "labels": {
        "name": "ethernet-1/10"
      }
    },
    {
      "id": "backup_saturation",
      "signal_type": "metrics",
      "name": "incident_backup_link_utilization",
      "generator": {
        "type": "saturation",
        "baseline": 20,
        "ceiling": 85,
        "time_to_saturate": "2m"
      },
      "labels": {
        "name": "ethernet-1/1",
        "path": "backup"
      },
      "after": {
        "ref": "primary_flap",
        "op": "<",
        "value": 1
      }
    },
    {
      "id": "latency_degrade",
      "signal_type": "metrics",
      "name": "incident_latency_ms",
      "generator": {
        "type": "degradation",
        "baseline": 5,
        "ceiling": 150,
        "time_to_degrade": "3m"
      },
      "labels": {
        "name": "ethernet-1/1",
        "path": "backup"
      },
      "after": {
        "ref": "backup_saturation",
        "op": ">",
        "value": 70
      }
    }
  ]
}